# Local projects are separate repositories and must not be uploaded with this kit.
/projects/

# Generated distribution packages.
/dist/
/*.tgz

# Local Node installation and logs.
/node_modules/
npm-debug.log*

# Per-task AI working state may contain local paths and should remain device-local.
**/.agent/cache/

# Recoverable backups created by the installer.
**/.codex/skills/*.backup-*/

# Common operating-system files.
.DS_Store
Thumbs.db
